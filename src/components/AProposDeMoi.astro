---
import { site } from '../data/site';

const principles = [
	{ title: 'Fiabilite', text: 'Tests, contracts, et monitoring pour eviter les surprises.' },
	{ title: 'Clarte', text: 'Definitions KPI, documentation, et modeles lisibles.' },
	{ title: 'Impact', text: 'Livrer vite, mesurer l usage, iterer sur la valeur.' },
];

const stack = [
	'Python',
	'SQL',
	'dbt',
	'Airflow',
	'BigQuery',
	'PostgreSQL',
	'Kafka',
	'Spark',
	'Docker',
	'Git',
];
---

<section class="py-6">
	<h1 class="text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">A propos</h1>
	<p class="mt-3 max-w-3xl text-base leading-relaxed text-gray-600 dark:text-gray-300">
		Je suis <span class="font-semibold text-gray-900 dark:text-white">{site.name}</span>, {site.role}. Je construis des
		pipelines de donnees modernes, des modeles analytiques, et des dashboards utiles aux equipes produit,
		ops, et business.
	</p>
</section>

<section class="py-8">
	<div class="grid gap-6 md:grid-cols-3">
		{principles.map((p) => (
			<div class="rounded-2xl border border-gray-200/70 bg-white/70 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-gray-950/50">
				<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">Principe</p>
				<h2 class="mt-2 text-lg font-semibold text-gray-900 dark:text-white">{p.title}</h2>
				<p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">{p.text}</p>
			</div>
		))}
	</div>
</section>

<section class="py-8">
	<div class="grid gap-8 md:grid-cols-12">
		<div class="md:col-span-7">
			<h2 class="text-xl font-semibold text-gray-900 dark:text-white">Ce que je fais</h2>
			<ul class="mt-4 space-y-2 text-sm text-gray-700 dark:text-gray-200">
				<li>- Ingestion: batch, streaming, connectors, schema validation</li>
				<li>- Transformation: ELT/ETL, incremental, orchestration</li>
				<li>- Analytics: modelisation, semantic layer, definitions KPI</li>
				<li>- Qualite: tests, freshness, lineage, alerting</li>
				<li>- Enablement: doc, templates, standards, mentoring</li>
			</ul>
		</div>
		<div class="md:col-span-5">
			<div class="rounded-3xl border border-gray-200/70 bg-white/70 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-gray-950/50">
				<h2 class="text-sm font-semibold text-gray-900 dark:text-white">Stack (exemples)</h2>
				<div class="mt-4 flex flex-wrap gap-2">
					{stack.map((t) => (
						<span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-white/10 dark:text-gray-200">{t}</span>
					))}
				</div>

				<div class="mt-6 flex flex-wrap gap-3">
					<a
						href={site.links.linkedin}
						target="_blank"
						rel="noreferrer"
						class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-5 py-2.5 text-sm font-semibold text-gray-800 hover:bg-gray-50 dark:border-white/10 dark:bg-gray-900 dark:text-gray-100 dark:hover:bg-gray-800"
					>
						LinkedIn
					</a>
					<a
						href={site.links.github}
						target="_blank"
						rel="noreferrer"
						class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-5 py-2.5 text-sm font-semibold text-gray-800 hover:bg-gray-50 dark:border-white/10 dark:bg-gray-900 dark:text-gray-100 dark:hover:bg-gray-800"
					>
						GitHub
					</a>
					<a
						href={`mailto:${site.email}`}
						class="inline-flex items-center justify-center rounded-full bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
					>
						Email
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="py-8">
	<div class="rounded-3xl border border-gray-200/70 bg-white/70 p-8 shadow-sm backdrop-blur dark:border-white/10 dark:bg-gray-950/50">
		<h2 class="text-xl font-semibold text-gray-900 dark:text-white">Workflow (simple et robuste)</h2>
		<div class="mt-6 grid gap-6 md:grid-cols-4">
			<div>
				<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">1. Cadrer</p>
				<p class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">Objectifs + KPIs</p>
				<p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Definitions, sources, et attentes metier.</p>
			</div>
			<div>
				<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">2. Construire</p>
				<p class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">Pipelines + modeles</p>
				<p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Orchestration, incremental, performance.</p>
			</div>
			<div>
				<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">3. Qualite</p>
				<p class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">Tests + monitoring</p>
				<p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Freshness, alerting, runbooks.</p>
			</div>
			<div>
				<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">4. Activer</p>
				<p class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">BI + adoption</p>
				<p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Dashboards, formation, feedback loop.</p>
			</div>
		</div>
	</div>
</section>
