---
import { site } from '../data/site';
---

<footer class="border-t border-gray-200/70 py-10 dark:border-white/10">
	<div class="mx-auto w-full max-w-6xl px-6">
		<div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
			<div>
				<p class="text-sm font-semibold text-gray-900 dark:text-white">{site.name}</p>
				<p class="text-sm text-gray-600 dark:text-gray-300">{site.headline}</p>
			</div>

			<div class="flex flex-wrap items-center gap-3 text-sm">
				<a
					class="rounded-full border border-gray-200 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-white/10 dark:bg-gray-900 dark:text-gray-200 dark:hover:bg-gray-800"
					href={site.links.github}
					target="_blank"
					rel="noreferrer"
				>
					GitHub
				</a>
				<a
					class="rounded-full border border-gray-200 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-white/10 dark:bg-gray-900 dark:text-gray-200 dark:hover:bg-gray-800"
					href={site.links.linkedin}
					target="_blank"
					rel="noreferrer"
				>
					LinkedIn
				</a>
				<a
					class="rounded-full bg-gray-900 px-4 py-2 font-semibold text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
					href={`mailto:${site.email}`}
				>
					Email
				</a>
			</div>
		</div>

		<p class="mt-8 text-xs text-gray-500 dark:text-gray-400">
			(c) {new Date().getFullYear()} {site.name}. Tous droits reserves.
		</p>
	</div>
</footer>
