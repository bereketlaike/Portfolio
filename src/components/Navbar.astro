---
import { site } from '../data/site';

const pathname = Astro.url?.pathname ?? '/';

const links = [
	{ href: '/', label: 'Accueil' },
	{ href: '/about', label: 'A propos' },
	{ href: '/projects', label: 'Projets' },
	{ href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<nav class="sticky top-0 z-50 border-b border-gray-200/60 bg-white/70 backdrop-blur dark:border-white/10 dark:bg-gray-950/60">
	<div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4">
		<a
			href="/"
			class="text-lg font-semibold tracking-tight text-gray-900 dark:text-white"
			aria-label={`${site.name} - Accueil`}
		>
			<span class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">{site.name}</span>
		</a>

		<div class="flex items-center gap-3">
			<details class="relative md:hidden">
				<summary
					class="inline-flex h-10 items-center justify-center gap-2 rounded-full border border-gray-200 bg-white px-4 text-sm font-semibold text-gray-800 hover:bg-gray-50 dark:border-white/10 dark:bg-gray-900 dark:text-gray-100 dark:hover:bg-gray-800"
					aria-label="Ouvrir le menu"
				>
					Menu
				</summary>
				<div
					class="absolute right-0 mt-2 w-56 rounded-2xl border border-gray-200 bg-white p-2 shadow-lg dark:border-white/10 dark:bg-gray-950"
				>
					{links.map((l) => (
						<a
							href={l.href}
							class:list={[
								'block rounded-xl px-3 py-2 text-sm font-semibold transition',
								isActive(l.href)
									? 'bg-gray-100 text-gray-900 dark:bg-white/10 dark:text-white'
									: 'text-gray-700 hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-white/10',
							]}
						>
							{l.label}
						</a>
					))}
					<a
						href="/projects"
						class="mt-1 block rounded-xl bg-gray-900 px-3 py-2 text-sm font-semibold text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
					>
						Voir les projets
					</a>
				</div>
			</details>

			<ul class="hidden items-center gap-6 text-sm font-medium md:flex">
				{
					links.map((l) => (
						<li>
							<a
								href={l.href}
								aria-current={isActive(l.href) ? 'page' : undefined}
								class:list={[
									'group relative py-2 transition-colors',
									isActive(l.href)
										? 'text-gray-900 dark:text-white'
										: 'text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white',
								]}
							>
								{l.label}
								<span
									class:list={[
										'absolute -bottom-0.5 left-0 h-0.5 w-full origin-left scale-x-0 bg-gradient-to-r from-blue-600 to-cyan-500 transition-transform',
										isActive(l.href) ? 'scale-x-100' : 'group-hover:scale-x-100',
									]}
							></span>
							</a>
						</li>
					))
				}
			</ul>

			<a
				href="/projects"
				class="hidden rounded-full bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100 md:inline-flex"
			>
				Voir les projets
			</a>

			<button
				type="button"
				data-theme-toggle
				class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-800 hover:bg-gray-50 dark:border-white/10 dark:bg-gray-900 dark:text-gray-100 dark:hover:bg-gray-800"
				aria-label="Basculer theme clair/sombre"
			>
				<svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z" stroke="currentColor" stroke-width="2" />
					<path
						d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l-1.5-1.5M20.5 20.5 19 19M19 5l1.5-1.5M4.5 20.5 6 19"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
				<svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M21 14.2A8.4 8.4 0 0 1 9.8 3a7.6 7.6 0 1 0 11.2 11.2Z"
						stroke="currentColor"
						stroke-width="2"
						stroke-linejoin="round"
					/>
				</svg>
			</button>
		</div>
	</div>
</nav>

<style>
	summary {
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
</style>
