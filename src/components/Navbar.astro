---
const languages = [
  { code: "en", label: "EN" },
  { code: "fr", label: "FR" }
];
---

<nav class="w-full flex justify-between items-center py-4 px-8 bg-white dark:bg-gray-900 shadow">
  <a href="/" class="text-2xl font-bold text-blue-600 dark:text-blue-400">
    Tafèssè
  </a>

  <ul class="flex items-center gap-6 text-lg">
    <li><a href="/" class="nav-link">Home</a></li>
    <li><a href="/about" class="nav-link">About</a></li>
    <li><a href="/projects" class="nav-link">Projects</a></li>
    <li><a href="/contact" class="nav-link">Contact</a></li>

    <!-- Language Switcher -->
    <select id="lang-switch"
      class="border px-2 py-1 rounded bg-gray-100 dark:bg-gray-800 dark:text-white">
      <option value="en">EN</option>
      <option value="fr">FR</option>
    </select>

    <!-- Dark/Light Mode Toggle -->
    <button id="theme-toggle" class="px-3 py-1 border rounded dark:text-white">
      🌙 / ☀️
    </button>
  </ul>
</nav>

<style>
  .nav-link {
    @apply text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition;
  }
</style>

<script>
  // THEME TOGGLE
  const toggleBtn = document.getElementById("theme-toggle");
  const root = document.documentElement;

  // Load saved theme
  if (localStorage.getItem("theme") === "dark") {
    root.classList.add("dark");
  }

  toggleBtn?.addEventListener("click", () => {
    root.classList.toggle("dark");
    localStorage.setItem("theme",
      root.classList.contains("dark") ? "dark" : "light"
    );
  });

  // LANGUAGE SWITCH
  const langSwitch = document.getElementById("lang-switch") as HTMLSelectElement;

  if(!langSwitch) return;

  // Load saved language
  langSwitch.value = localStorage.getItem("lang") || "en";

  langSwitch.addEventListener("change", () => {
    localStorage.setItem("lang", langSwitch.value);
    location.reload(); // refresh page to apply translation
  });
</script>
