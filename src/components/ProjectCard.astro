---
import type { DataProject } from '../data/projects';

const { project } = Astro.props as { project: DataProject };
---

<article
	class="group rounded-2xl border border-gray-200/70 bg-white/70 p-6 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:shadow-md dark:border-white/10 dark:bg-gray-950/50"
>
	<div class="flex items-start justify-between gap-4">
		<div>
			<h3 class="text-lg font-semibold text-gray-900 dark:text-white">{project.title}</h3>
			<p class="mt-1 text-sm text-gray-600 dark:text-gray-300">{project.summary}</p>
		</div>
		<span class="shrink-0 rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-gray-700 dark:border-white/10 dark:bg-gray-900 dark:text-gray-200">
			{project.year}
		</span>
	</div>

	<ul class="mt-4 space-y-2 text-sm text-gray-700 dark:text-gray-200">
		{project.highlights.slice(0, 3).map((h) => <li class="leading-relaxed">- {h}</li>)}
	</ul>

	<div class="mt-5 flex flex-wrap gap-2">
		{project.stack.map((t) => (
			<span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-white/10 dark:text-gray-200">
				{t}
			</span>
		))}
	</div>

	<div class="mt-6 flex flex-wrap gap-3">
		{project.links.map((l) => (
			<a
				href={l.href}
				class="text-sm font-semibold text-blue-700 hover:text-blue-800 dark:text-cyan-300 dark:hover:text-cyan-200"
			>
				{l.label} ->
			</a>
		))}
	</div>
</article>
