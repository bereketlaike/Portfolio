---
import Navbar from "../components/Navbar.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Welcome | Tafèssè Portfolio</title>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <Navbar />

    <!-- Hero Section -->
    <section class="flex flex-col md:flex-row items-center justify-between px-8 py-20 max-w-6xl mx-auto">
      <!-- Text -->
      <div class="max-w-xl">
        <h1 class="text-4xl md:text-6xl font-bold mb-4">
          Hello, I'm <span class="text-blue-600">Tafèssè</span>
        </h1>

        <p class="text-lg md:text-xl text-gray-700 mb-6 leading-relaxed">
          Data Engineer & Analytics Enthusiast — passionate about building
          modern data pipelines, analytics dashboards, automation scripts,
          and end-to-end data solutions.
        </p>

        <a
          href="/projects"
          class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg text-lg hover:bg-blue-700 transition"
        >
          View My Projects
        </a>
      </div>

      <!-- Image -->
      <img
        src="/profile.png"
        alt="Profile"
        class="w-60 h-60 mt-10 md:mt-0 rounded-full shadow-lg object-cover"
      />
    </section>
  </body>
</html>
