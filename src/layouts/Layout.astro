---
import '../styles/global.css';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const {
	title = 'Portfolio Data | Bereket Laike Tafesse',
	description = 'Portfolio data: data engineering, analytics, pipelines, dashboards, automatisation.',
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body
		class="min-h-screen bg-white text-gray-900 transition-colors duration-300 dark:bg-gray-950 dark:text-white"
	>
		<!-- Background: subtle grid + glow -->
		<div class="pointer-events-none fixed inset-0 -z-10">
			<div class="absolute inset-0 bg-[radial-gradient(1200px_circle_at_20%_10%,rgba(37,99,235,0.16),transparent_55%),radial-gradient(1000px_circle_at_85%_30%,rgba(14,165,233,0.14),transparent_55%)]"></div>
			<div class="absolute inset-0 opacity-[0.08] [background-image:linear-gradient(to_right,rgba(17,24,39,0.18)_1px,transparent_1px),linear-gradient(to_bottom,rgba(17,24,39,0.18)_1px,transparent_1px)] [background-size:44px_44px] dark:opacity-[0.12]"></div>
		</div>

		<Navbar />

		<main class="mx-auto w-full max-w-6xl px-6 py-10 md:py-14">
			<slot />
		</main>

		<Footer />
		<script>
			// Theme init + toggle
			const html = document.documentElement;
			const theme = localStorage.getItem('theme');

			if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				html.classList.add('dark');
			}

			const toggle = document.querySelector('[data-theme-toggle]');
			if (toggle) {
				toggle.addEventListener('click', () => {
					const isDark = html.classList.toggle('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
			}
		</script>
	</body>
</html>
