---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
---

<Layout title={`Projets | ${site.name}`} description="Projets data: plateformes, pipelines, streaming, BI.">
	<section class="py-6">
		<h1 class="text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">Projets</h1>
		<p class="mt-3 max-w-3xl text-base leading-relaxed text-gray-600 dark:text-gray-300">
			Une selection de projets data. Chaque fiche met l accent sur le contexte, les choix techniques, et l impact.
		</p>
	</section>

	<section class="py-8">
		<div class="grid gap-5 md:grid-cols-2">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	<section class="py-10">
		<h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white">Details</h2>
		<p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
			Format case study: probleme, approche, resultats, stack.
		</p>

		<div class="mt-6 space-y-6">
			{projects.map((p) => (
				<article
					id={p.slug}
					class="scroll-mt-24 rounded-3xl border border-gray-200/70 bg-white/70 p-8 shadow-sm backdrop-blur dark:border-white/10 dark:bg-gray-950/50"
				>
					<div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
						<div>
							<h3 class="text-xl font-semibold text-gray-900 dark:text-white">{p.title}</h3>
							<p class="mt-1 text-sm text-gray-600 dark:text-gray-300">{p.summary}</p>
						</div>
						<span class="mt-2 inline-flex w-fit rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-gray-700 dark:border-white/10 dark:bg-gray-900 dark:text-gray-200 md:mt-0">
							{p.year}
						</span>
					</div>

					<div class="mt-6 grid gap-6 md:grid-cols-3">
						<div class="md:col-span-2">
							<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">Highlights</p>
							<ul class="mt-3 space-y-2 text-sm text-gray-700 dark:text-gray-200">
								{p.highlights.map((h) => <li>- {h}</li>)}
							</ul>
						</div>
						<div>
							<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">Stack</p>
							<div class="mt-3 flex flex-wrap gap-2">
								{p.stack.map((t) => (
									<span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-white/10 dark:text-gray-200">
										{t}
									</span>
								))}
							</div>

							<div class="mt-5 flex flex-wrap gap-3">
								{p.links.map((l) => (
									<a
										href={l.href}
										class="text-sm font-semibold text-blue-700 hover:text-blue-800 dark:text-cyan-300 dark:hover:text-cyan-200"
									>
										{l.label} ->
									</a>
								))}
							</div>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>
</Layout>
